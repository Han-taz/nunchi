# Copy to deploy/.env and edit. Placeholders only; .env is gitignored.
POSTGRES_PASSWORD=change-me-postgres
APP_RW_PASSWORD=change-me-app-rw
WORKER_PASSWORD=change-me-worker
NUNCHI_WORKER_DATABASE_URL=postgres://nunchi_worker:change-me-worker@postgres:5432/postgres
DEV_ISSUER=https://dev-idp.test
API_PORT=8080
MCP_PORT=8000
# Leave empty to extract with NullExtractor (every capture becomes a note).
ANTHROPIC_API_KEY=
# Embeddings (OpenAI-compatible endpoint serving embeddinggemma). Leave the base URL empty to search by trigram only.
# The key is a placeholder; put the real value only in deploy/.env.
NUNCHI_EMBEDDING_BASE_URL=
NUNCHI_EMBEDDING_API_KEY=
NUNCHI_EMBEDDING_MODEL=embeddinggemma-2
NUNCHI_EMBEDDING_DIM=512
